# Copy to .env or inject these variables into the server process. Never expose keys in the browser.
# AI_API_KEY needs HTTPS access to api.openai.com.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=3000
# Optional shared password for public deployments (HTTP Basic Auth; use HTTPS).
APP_PASSWORD=
